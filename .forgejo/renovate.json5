{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  timezone: "Asia/Tokyo",
  minimumReleaseAge: "3 days",
  semanticCommits: "disabled",
  commitMessagePrefix: "deps:",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3:00am on monday"],
  },
  automerge: true,
  automergeStrategy: "squash",
  rebaseWhen: "conflicted",
  prConcurrentLimit: 5,
  packageRules: [
    {
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // `#[implement]` expands to `::windows_core` paths, so windows-core
      // must be the series `windows` itself builds on: one PR moves both.
      matchPackageNames: ["windows", "windows-core"],
      groupName: "windows-rs",
    },
    {
      // accesskit_winit consumes accesskit's tree types, so a breaking
      // accesskit release only builds alongside the matching accesskit_winit.
      matchPackageNames: ["accesskit", "accesskit_winit"],
      groupName: "accesskit",
    },
    {
      // A new ConPTY host can change what shells see in ways the tests do
      // not cover: read the Windows Terminal release notes before merging.
      matchPackageNames: ["conpty-bin-vendored"],
      automerge: false,
    },
  ],
  nix: {
    enabled: true,
  },
}
