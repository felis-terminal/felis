{
  "$defs": {
    "AttachmentObject": {
      "properties": {
        "attached_at": {
          "description": "RFC 3339, UTC.",
          "type": "string"
        },
        "id": {
          "description": "A decimal **string**: the id is a `u64` counter, and a bare JSON\nnumber past 2^53−1 silently rounds in common consumers.\n`--attachment` accepts the same spelling.",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "input_owner": {
          "description": "Unconditional, unlike the optionals elsewhere: an omitted key\nwould read as \"this daemon does not report it\".",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "attached_at",
        "input_owner"
      ],
      "type": "object"
    },
    "BuildIdentity": {
      "description": "Semver, exact source revision, and dirty status.\n\nThe canonical round-tripping form is `<version> (<revision>[-dirty])`.\n[`BuildIdentity::human`] provides an abbreviated non-round-tripping form.",
      "properties": {
        "dirty": {
          "description": "The working tree had uncommitted tracked changes when this was\nbuilt, so `revision` names its parent, not its source.",
          "type": "boolean"
        },
        "revision": {
          "description": "Full lowercase-hex git revision, or [`UNKNOWN_REVISION`].",
          "type": "string"
        },
        "version": {
          "description": "Cargo package semver, e.g. `0.1.0`.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "revision",
        "dirty"
      ],
      "type": "object"
    },
    "BuildsObject": {
      "properties": {
        "cli": {
          "type": "string"
        },
        "client": {
          "description": "`null` when the GUI frontend could not be probed.",
          "type": [
            "string",
            "null"
          ]
        },
        "daemon": {
          "description": "`null` when no daemon answered with an identity; the `daemon`\ncheck says why.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cli",
        "client",
        "daemon"
      ],
      "type": "object"
    },
    "CaptureRow": {
      "properties": {
        "ansi": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "description": "The region's own coordinate space: scrollback negative (`-1` the\nyoungest), live rows their grid index, mark ranges from 0.",
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "soft_wrap_continued": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "row",
        "text",
        "soft_wrap_continued"
      ],
      "type": "object"
    },
    "CheckObject": {
      "properties": {
        "check": {
          "description": "The check's stable token (`daemon`, `daemon-sibling`, `config`,\n`terminfo`, `gpu`, `clipboard`, `remote_helper`).",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "status": {
          "description": "`ok`, `warn`, `fail`, or `skipped`; the last is neither a pass\nnor a problem.",
          "type": "string"
        }
      },
      "required": [
        "check",
        "status",
        "detail"
      ],
      "type": "object"
    },
    "CheckResult": {
      "properties": {
        "client": {
          "type": "string"
        },
        "diagnostics": {
          "description": "Always present, empty for a clean file.",
          "items": {
            "$ref": "#/$defs/DiagnosticObject"
          },
          "type": "array"
        },
        "errors": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "exists": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "warnings": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        }
      },
      "required": [
        "path",
        "exists",
        "client",
        "errors",
        "warnings",
        "diagnostics"
      ],
      "type": "object"
    },
    "ConfigObject": {
      "properties": {
        "diff": {
          "description": "The keys whose values differ from the defaults, nested as in\n`config.toml`. `[client.*]` is never included, and the arguments\nof `send_string`, `run`, and command or file `pipe` bindings read\n`<redacted>`."
        },
        "path": {
          "description": "`null` when felis found no home directory to look in.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "`absent` (no file; the defaults apply), `applied`, or `invalid`\n(the file has errors and the defaults apply instead).",
          "type": "string"
        }
      },
      "required": [
        "path",
        "state",
        "diff"
      ],
      "type": "object"
    },
    "ConfigPathResult": {
      "properties": {
        "exists": {
          "description": "The path is reported either way.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "exists"
      ],
      "type": "object"
    },
    "DaemonStatusResult": {
      "description": "The session count is not a field of its own: it is the `sessions`\nrow's `total_used`, and two spellings of one number can disagree.",
      "properties": {
        "draining": {
          "description": "The daemon refuses creates and exits after its last session.",
          "type": "boolean"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "resources": {
          "description": "The order is presentation, not contract; a consumer keys on\n`resource`.",
          "items": {
            "$ref": "#/$defs/ResourceObject"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        },
        "worker_threads": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "protocol",
        "worker_threads",
        "draining",
        "resources"
      ],
      "type": "object"
    },
    "DaemonStopResult": {
      "description": "`daemon stop`'s answer. The mode rides beside the outcome so a\nreader can tell a stop that destroyed sessions from one that found\nnone.",
      "properties": {
        "mode": {
          "description": "`if_empty`, `force`, or `when_empty`: what was asked for, not\nwhat the daemon decided.",
          "type": "string"
        },
        "outcome": {
          "description": "`stopping`, `refused`, or `draining`.",
          "type": "string"
        },
        "sessions": {
          "description": "Sessions the outcome speaks about: those still held on\n`draining`, `0` on `stopping`.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "mode",
        "sessions"
      ],
      "type": "object"
    },
    "DaemonUpgradeResult": {
      "description": "`daemon upgrade`'s answer. A refusal is an error object instead,\nso `outcome` has one value today; it is spelled out for a reader\nthat dispatches on it as it does on `daemon stop`'s.",
      "properties": {
        "outcome": {
          "description": "`upgrading`.",
          "type": "string"
        },
        "successor": {
          "description": "The absolute path of the `felis-daemon` the daemon execs.",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "successor"
      ],
      "type": "object"
    },
    "DiagnosticObject": {
      "properties": {
        "key": {
          "description": "The dotted key path **as written in the document**, so a typo\ninside an overlay reads `client.<id>.<path>`. Absent for a\ndiagnostic about the file rather than a key.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The category token: `io`, `parse`, `unknown_key`, `value`,\n`missing_file`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "description": "`error` or `warning`; only the first moves the exit code.",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "DisplayObject": {
      "properties": {
        "desktop": {
          "description": "`XDG_CURRENT_DESKTOP`.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_type": {
          "description": "`XDG_SESSION_TYPE`.",
          "type": [
            "string",
            "null"
          ]
        },
        "wayland": {
          "description": "Whether `WAYLAND_DISPLAY` is set; its value is not reported.",
          "type": "boolean"
        },
        "x11": {
          "description": "Whether `DISPLAY` is set; its value is not reported.",
          "type": "boolean"
        }
      },
      "required": [
        "session_type",
        "desktop",
        "wayland",
        "x11"
      ],
      "type": "object"
    },
    "DoctorReportResult": {
      "description": "`felis doctor report`: the checklist plus the environment, with every\npath under `$HOME` already shown as `~`.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckObject"
          },
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentObject"
        },
        "failed": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "warned": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        }
      },
      "required": [
        "failed",
        "warned",
        "checks",
        "environment"
      ],
      "type": "object"
    },
    "DoctorResult": {
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckObject"
          },
          "type": "array"
        },
        "failed": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "warned": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        }
      },
      "required": [
        "failed",
        "warned",
        "checks"
      ],
      "type": "object"
    },
    "EffectiveConfigResult": {
      "description": "The config sits under its own key rather than flattened, so `v` and\nthe provenance cannot collide with a config section name.",
      "properties": {
        "client": {
          "type": "string"
        },
        "config": true,
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "client",
        "config"
      ],
      "type": "object"
    },
    "EnvironmentObject": {
      "properties": {
        "binary": {
          "description": "This `felis` binary's path: tells a Nix store, Homebrew, or a\nsource build apart.",
          "type": [
            "string",
            "null"
          ]
        },
        "builds": {
          "$ref": "#/$defs/BuildsObject"
        },
        "config": {
          "$ref": "#/$defs/ConfigObject"
        },
        "display": {
          "$ref": "#/$defs/DisplayObject"
        },
        "fonts": {
          "$ref": "#/$defs/FontsObject"
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuObject"
            },
            {
              "type": "null"
            }
          ],
          "description": "`null` when the GUI frontend could not be probed."
        },
        "locale": {
          "$ref": "#/$defs/LocaleObject"
        },
        "logs": {
          "items": {
            "$ref": "#/$defs/LogObject"
          },
          "type": "array"
        },
        "os": {
          "$ref": "#/$defs/OsObject"
        },
        "shell": {
          "$ref": "#/$defs/ShellObject"
        }
      },
      "required": [
        "builds",
        "binary",
        "os",
        "display",
        "gpu",
        "locale",
        "shell",
        "fonts",
        "config",
        "logs"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "An additive failure vocabulary; `x-known-values` lists this epoch's tokens.",
      "type": "string",
      "x-known-values": [
        "usage",
        "no_match",
        "ambiguous",
        "timeout",
        "no_input_owner",
        "no_such_attachment",
        "not_queued",
        "session_ended",
        "malformed_request",
        "invalid_request",
        "at_capacity",
        "unsupported",
        "daemon_unreachable",
        "daemon_lost",
        "refused",
        "protocol",
        "canceled",
        "input_failed",
        "output_failed",
        "internal"
      ]
    },
    "FontsObject": {
      "description": "The faces a window would draw with. Exactly one of the face fields\nand `unavailable` is set.",
      "properties": {
        "bold": {
          "type": [
            "string",
            "null"
          ]
        },
        "bold_italic": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallbacks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "italic": {
          "type": [
            "string",
            "null"
          ]
        },
        "regular": {
          "type": [
            "string",
            "null"
          ]
        },
        "unavailable": {
          "description": "Why no stack is reported: the frontend could not be probed,\npredates the font probe, or resolved no font.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "regular",
        "bold",
        "italic",
        "bold_italic",
        "fallbacks",
        "unavailable"
      ],
      "type": "object"
    },
    "GpuObject": {
      "properties": {
        "available": {
          "type": "boolean"
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver_info": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "available",
        "name",
        "backend",
        "device_type",
        "driver",
        "driver_info"
      ],
      "type": "object"
    },
    "LastNotificationObject": {
      "properties": {
        "age_seconds": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "body": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "urgency": {
          "type": "string"
        }
      },
      "required": [
        "body",
        "urgency",
        "age_seconds"
      ],
      "type": "object"
    },
    "ListResult": {
      "description": "`sessions list`'s whole answer. The roster is bounded and arrives in\none frame, so it is a point result: a stream framing would promise a\nsource that can grow or arrive incrementally, and this one cannot\n(docs/explanation/architecture/control-surfaces.md).",
      "properties": {
        "sessions": {
          "description": "Always present, empty for an empty roster.",
          "items": {
            "$ref": "#/$defs/SessionObject"
          },
          "type": "array"
        }
      },
      "required": [
        "sessions"
      ],
      "type": "object"
    },
    "LocaleObject": {
      "properties": {
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "lc_all": {
          "type": [
            "string",
            "null"
          ]
        },
        "lc_ctype": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lang",
        "lc_all",
        "lc_ctype"
      ],
      "type": "object"
    },
    "LogObject": {
      "properties": {
        "name": {
          "description": "`daemon.log` or `client.log`.",
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "present": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "path",
        "present"
      ],
      "type": "object"
    },
    "MachineError": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "type": "string"
        },
        "reason": {
          "description": "Why the daemon refused, on `daemon upgrade`'s refusal alone:\n`unsupported`, `dump_version`, `protocol_major`, `timeout`,\n`probe_failed`, `busy`, or `draining`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessions": {
          "description": "Sessions the daemon still holds, on `daemon stop`'s refusal\nalone: the count is what the caller decides between `--force`\nand `--when-empty` on, and re-reading it out of the message\nwould make prose a parse target.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "NotificationObject": {
      "properties": {
        "attached": {
          "type": "boolean"
        },
        "body": {
          "type": "string"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "notification_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "session_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Explicitly `null` rather than omitted, here and below: this\nobject is the whole of what a subscriber learns about an event.",
          "type": [
            "string",
            "null"
          ]
        },
        "urgency": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "title",
        "body",
        "urgency",
        "notification_id",
        "session_title",
        "cwd",
        "attached"
      ],
      "type": "object"
    },
    "OsObject": {
      "properties": {
        "arch": {
          "type": "string"
        },
        "family": {
          "description": "`std::env::consts::OS`: `linux`, `macos`, `windows`, …",
          "type": "string"
        },
        "kernel": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "description": "The distribution or product version, where this platform names\none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "family",
        "arch",
        "release",
        "kernel"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "ResourceObject": {
      "description": "Each number names its own denominator, so a consumer never has to\ninfer one: `total_used` belongs with `global_limit`,\n`max_subject_used` with `per_subject_limit`, and the two pairs are\nnever mixed.",
      "properties": {
        "global_limit": {
          "description": "Absent where felis budgets no daemon-wide aggregate.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ],
          "x-bound-exceeds-f64-precision": true
        },
        "max_subject_used": {
          "description": "Absent (not null) on a `daemon`-scope row, whose only subject is\n`total_used`.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ],
          "x-bound-exceeds-f64-precision": true
        },
        "per_subject_limit": {
          "description": "Absent on a `daemon`-scope row and where felis admits a subject\nwithout a ceiling.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ],
          "x-bound-exceeds-f64-precision": true
        },
        "resource": {
          "description": "The stable row key, never a display label.",
          "type": "string"
        },
        "scope": {
          "description": "`daemon`, `session`, or `subscriber`: what one subject is.",
          "type": "string"
        },
        "total_used": {
          "description": "Summed over every subject. Present on every row.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer",
          "x-bound-exceeds-f64-precision": true
        },
        "unit": {
          "description": "`count` or `bytes`.",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "unit",
        "scope",
        "total_used"
      ],
      "type": "object"
    },
    "RetargetResult": {
      "properties": {
        "from": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "queued": {
          "description": "Subscriber outboxes that took the push. As with `switch`, exit 0\nclaims admission alone; the re-dial onto the target carrier runs\nafterwards, out of this invocation's sight.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "queued"
      ],
      "type": "object"
    },
    "SearchMatch": {
      "description": "`col_spans` are per-row highlight segments: a match crossing a\nsoft-wrap edge emits one per touched row, so they are not 1:1 with\n`byte_spans`.",
      "properties": {
        "byte_spans": {
          "items": {
            "items": {
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "col_spans": {
          "items": {
            "items": {
