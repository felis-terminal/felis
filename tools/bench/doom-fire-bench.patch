 ///////////////////////////////////
+// bench mode (felis cross-terminal suite)
+///////////////////////////////////
+
+// DOOM_BENCH_SECS turns the demo into an unattended, fixed-length run
+// that reports its own frame rate. Upstream only ever draws the rate on
+// screen and never exits, so a harness comparing terminals can neither
+// read the number nor end the run.
+var bench_secs: i64 = 0;
+var bench_deadline: i64 = 0;
+
+pub fn initBench() void {
+    if (builtin.os.tag == .windows) return;
+    const raw = std.posix.getenv("DOOM_BENCH_SECS") orelse return;
+    bench_secs = std.fmt.parseInt(i64, raw, 10) catch 0;
+}
+
+pub fn benchRunning() bool {
+    return bench_secs == 0 or std.time.milliTimestamp() < bench_deadline;
+}
+
+// stderr, not stdout: stdout is the fire itself, so anything printed
+// there is just more payload on the screen being measured.
+pub fn reportBench() void {
+    if (bench_secs == 0) return;
+    std.io.getStdErr().writer().print(
+        "doom-fire frames {d} secs {d:.3} fps {d:.3} bytes_avg {d}\n",
+        .{ bs_frame_tic, t_dur, fps, bs_sz_avg },
+    ) catch {};
+}
+
+///////////////////////////////////
 // main
 ///////////////////////////////////

@@ -838,12 +870,18 @@
     stdout = std.io.getStdOut().writer();
     stdin = std.io.getStdIn().reader();

+    initBench();
     try initTerm();
     defer complete() catch {};

-    try checkTermSz();
-    try showTermCap();
